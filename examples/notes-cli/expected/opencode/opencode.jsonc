{
  "permission": {
    "*": "allow",
    "read": {
      "~/projects/**": "allow",
      "~/.claude/projects/**": "allow",
      "~/.claude/**": "allow",
      "~/.codex/**": "allow",
      "~/.gemini/**": "allow",
      "~/.cursor/**": "allow",
      "~/.config/opencode/**": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/Library/Application Support/Google/Chrome/**": "deny",
      "~/Library/Application Support/Firefox/**": "deny",
      "~/Library/Application Support/BraveSoftware/**": "deny",
      "~/Library/Application Support/Microsoft Edge/**": "deny",
      "~/Library/Safari/**": "deny",
      "~/Library/Keychains/**": "deny",
      "**/settings.local.json": "deny"
    },
    "edit": {
      "~/projects/**": "allow",
      "~/.claude/projects/**": "allow",
      "~/.claude/**": "allow",
      "~/.codex/**": "allow",
      "~/.gemini/**": "allow",
      "~/.cursor/**": "allow",
      "~/.config/opencode/**": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "/etc/**": "deny",
      "/usr/**": "deny",
      "/Library/**": "deny",
      "~/.claude/plugins/**": "deny"
    },
    "bash": {
      "git *": "allow",
      "gh *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "stat *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "test *": "allow",
      "[ * ]": "allow",
      "pwd": "allow",
      "true": "allow",
      "false": "allow",
      "date *": "allow",
      "which *": "allow",
      "file *": "allow",
      "tree *": "allow",
      "du *": "allow",
      "df *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "env": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "awk *": "allow",
      "sed *": "allow",
      "jq *": "allow",
      "shasum *": "allow",
      "md5 *": "allow",
      "xxd *": "allow",
      "base64 *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "rmdir *": "allow",
      "chmod +x *": "allow",
      "ln -s *": "allow",
      "python3 *": "allow",
      "python *": "allow",
      "pytest *": "allow",
      "uv *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "npm run *": "allow",
      "npm test *": "allow",
      "npm ci *": "allow",
      "npm install": "allow",
      "npm install *": "allow",
      "pnpm run *": "allow",
      "pnpm test *": "allow",
      "pnpm install *": "allow",
      "make *": "allow",
      "pre-commit *": "allow",
      "shellcheck *": "allow",
      "claude *": "allow",
      "rm -r*": "deny",
      "rm -R*": "deny",
      "rm -f -r *": "deny",
      "rm -f -R *": "deny",
      "rm --recursive *": "deny",
      "rm * -r*": "deny",
      "rm * -R*": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chown *": "deny",
      "gh repo delete *": "deny",
      "gh project delete *": "deny",
      "npm publish *": "deny",
      "pnpm publish *": "deny",
      "yarn publish *": "deny",
      "npm install -g *": "deny",
      "npm i -g *": "deny"
    },
    "external_directory": {
      "~/projects/**": "allow",
      "~/.claude/**": "allow",
      "~/.codex/**": "allow",
      "~/.gemini/**": "allow",
      "~/.cursor/**": "allow",
      "~/.config/opencode/**": "allow"
    }
  }
}
