{
  "version": 1,
  "runtime_settings": {
    "claude": {
      "model": "inherit",
      "aliases": {
        "large": "example-large-model"
      },
      "settings": {
        "exampleSetting": true
      }
    },
    "codex": {
      "model": "example-model",
      "subagent_model": "example-small-model"
    },
    "opencode": {
      "model": "example-provider/example-model",
      "provider": {
        "example-provider": {
          "options": {
            "baseURL": "http://localhost:8080/v1"
          }
        }
      }
    }
  },
  "mcp_servers": [
    {
      "name": "example-server",
      "runtimes": [
        "claude",
        "codex"
      ],
      "owner": "example-owner",
      "wanted": true,
      "command": "example-mcp",
      "args": [
        "--stdio"
      ],
      "env": {
        "EXAMPLE_TOKEN": "secret://example/token"
      }
    },
    {
      "name": "example-remote",
      "runtimes": [
        "gemini"
      ],
      "owner": "example-owner",
      "wanted": true,
      "url": "https://mcp.example.com/sse",
      "transport": "sse"
    },
    {
      "name": "Example Hosted Connector",
      "runtimes": [
        "claude"
      ],
      "owner": "example-provider",
      "wanted": false,
      "hosted": true
    }
  ],
  "plugins": [
    {
      "name": "example-plugin",
      "runtimes": [
        "claude"
      ],
      "owner": "example-owner",
      "wanted": true,
      "marketplace": "example-marketplace"
    },
    {
      "name": "example-file-plugin",
      "runtimes": [
        "opencode"
      ],
      "owner": "example-owner",
      "wanted": true,
      "path": "plugins/example.js"
    }
  ],
  "foreign_hooks": [
    {
      "name": "example-hook",
      "runtimes": [
        "claude",
        "codex"
      ],
      "owner": "example-tool",
      "wanted": true,
      "match": "example-tool hook",
      "registration": {
        "claude": "hooks/foreign/example-claude.json"
      }
    },
    {
      "name": "example-unwanted-hook",
      "runtimes": [
        "claude"
      ],
      "owner": "example-tool",
      "wanted": false,
      "match": "unwanted-tool"
    }
  ],
  "third_party_skills": [
    {
      "name": "example-skill-pack",
      "runtimes": [
        "claude"
      ],
      "owner": "example-tool",
      "wanted": true,
      "installer": "example-tool skills install",
      "skills": [
        "example-skill-a",
        "example-skill-b"
      ]
    }
  ],
  "dependencies": [
    {
      "name": "example-base",
      "runtimes": [
        "claude"
      ],
      "owner": "example-owner",
      "wanted": true,
      "command": "example",
      "install": "built into the base image",
      "version": "1.0.0"
    },
    {
      "name": "example-apt",
      "runtimes": [
        "claude"
      ],
      "owner": "example-owner",
      "wanted": true,
      "command": "example-apt",
      "install": "apt-get install example-apt",
      "version": "2.0.0",
      "version_command": "example-apt --version",
      "platform": "linux"
    },
    {
      "name": "example-release",
      "runtimes": [
        "codex"
      ],
      "owner": "example-owner",
      "wanted": true,
      "command": "example-release",
      "install": "download the release archive",
      "version": "3.0.0"
    },
    {
      "name": "example-source",
      "runtimes": [
        "claude"
      ],
      "owner": "example-owner",
      "wanted": true,
      "command": "example-source",
      "install": "compile from the release tarball",
      "version": "4.0.0"
    }
  ]
}
