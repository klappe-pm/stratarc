{
  "version": 1,
  "runtime_settings": {
    "claude": {
      "model": "example-model",
      "settings": {
        "statusLine": {
          "type": "command",
          "command": "statusline"
        }
      }
    },
    "opencode": {
      "provider": {
        "local-gateway": {
          "npm": "@ai-sdk/openai-compatible",
          "options": {
            "baseURL": "http://127.0.0.1:3001/v1"
          }
        }
      }
    }
  },
  "mcp_servers": [
    {
      "name": "search",
      "runtimes": [
        "claude",
        "codex"
      ],
      "owner": "example",
      "wanted": true,
      "command": "npx",
      "args": [
        "-y",
        "example-search"
      ],
      "env": {
        "SEARCH_TOKEN": "secret://example/search-token"
      }
    }
  ],
  "plugins": [
    {
      "name": "workflow-helpers",
      "runtimes": [
        "claude"
      ],
      "owner": "example",
      "wanted": true,
      "marketplace": "example-marketplace"
    }
  ],
  "foreign_hooks": [
    {
      "name": "vendor-hook",
      "runtimes": [
        "claude"
      ],
      "owner": "example",
      "wanted": false,
      "match": "vendor-hook run"
    }
  ],
  "third_party_skills": [
    {
      "name": "style-skills",
      "runtimes": [
        "claude"
      ],
      "owner": "example",
      "wanted": true,
      "installer": "npx style-skills install",
      "skills": [
        "style-review",
        "style-fix"
      ]
    }
  ],
  "dependencies": [
    {
      "name": "ripgrep",
      "runtimes": [
        "claude",
        "codex"
      ],
      "owner": "example",
      "wanted": true,
      "command": "rg",
      "install": "brew install ripgrep",
      "version": "14.1.1"
    }
  ]
}
